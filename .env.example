# Emporia Energy Vue credentials
EMPORIA_EMAIL=your_email@example.com
EMPORIA_PASSWORD=your_password

# SunPower PVS6 (leave empty, use Discovery page to find)
PVS6_HOST=
PVS6_PORT=443
PVS6_USE_HTTPS=true

# Electricity rate ($/kWh)
ELECTRICITY_RATE=0.12

# Crypto circuit IDs (comma-separated Emporia channel numbers)
CRYPTO_CIRCUIT_IDS=

# Network discovery subnet
DISCOVERY_SUBNET=192.168.1.0/24

# Polling intervals (seconds)
POLL_INTERVAL_SECONDS=60
HISTORY_POLL_INTERVAL=900

# Data retention (days)
RAW_RETENTION_DAYS=7
HOURLY_RETENTION_DAYS=90

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
