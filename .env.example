# Emporia Energy Vue credentials (monitors crypto mining circuits only)
EMPORIA_EMAIL=your_email@example.com
EMPORIA_PASSWORD=your_password

# SunPower/SunStrong cloud API (solar production + house consumption)
SUNPOWER_EMAIL=your_sunstrong_email@example.com
SUNPOWER_PASSWORD=your_sunstrong_password

# SunPower PVS6 via Pi Zero bridge (HTTP, port 80)
# Pi bridge IP on home network — set to your Pi's WiFi IP
PVS6_HOST=192.168.x.x
PVS6_PORT=80
PVS6_USE_HTTPS=false

# CORE Electric Cooperative "Residential Demand" (Schedule C) — from the Sep 2026 bill.
# Demand = highest 60-minute average kW at any hour of the month.
ENERGY_RATE=0.08907
WPCA_RATE=0.00379
DEMAND_RATE=15.38
BASE_SERVICE_CHARGE=20.00
TAX_RATE=0.067
LOCAL_TIMEZONE=America/Denver

# Crypto circuit IDs (comma-separated Emporia channel numbers)
CRYPTO_CIRCUIT_IDS=

# Network discovery subnet
DISCOVERY_SUBNET=192.168.1.0/24

# Polling intervals (seconds)
POLL_INTERVAL_SECONDS=60
HISTORY_POLL_INTERVAL=900

# Data retention (days)
RAW_RETENTION_DAYS=7
HOURLY_RETENTION_DAYS=90

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false

# Dashboard authentication (leave DASHBOARD_PASSWORD blank to disable auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
